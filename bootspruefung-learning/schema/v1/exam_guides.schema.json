{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.learnboating.invalid/v1/exam_guides.schema.json",
  "title": "Anleitungen zur Prüfungsanmeldung je Prüfung (data/exam_guides.json, ab 1.3)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "tab", "title", "intro", "fee", "lead_time", "min_age", "apply", "deadline", "documents", "variants", "exam_parts", "faq", "providers", "courses", "sort_order", "rights_status", "source_file", "hash"],
    "properties": {
      "source_id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
      "tab": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "intro": { "type": "string" },
      "fee": { "type": "string" },
      "lead_time": { "$ref": "common.schema.json#/$defs/nullableText" },
      "min_age": { "type": "string" },
      "apply": { "type": "string" },
      "deadline": { "type": "string" },
      "documents": { "type": "array", "items": { "type": "string" } },
      "variants": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "label", "course_code", "parts", "minutes", "pass", "extra", "note"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "course_code": { "type": ["string", "null"] },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["module", "label", "of", "min"],
                "properties": {
                  "module": { "$ref": "common.schema.json#/$defs/moduleCode" },
                  "label": { "$ref": "common.schema.json#/$defs/nullableText" },
                  "of": { "type": ["integer", "null"] },
                  "min": { "type": ["integer", "null"] }
                }
              }
            },
            "minutes": { "type": ["integer", "null"] },
            "pass": { "$ref": "common.schema.json#/$defs/nullableText" },
            "extra": { "$ref": "common.schema.json#/$defs/nullableText" },
            "note": { "$ref": "common.schema.json#/$defs/nullableText" }
          }
        }
      },
      "exam_parts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "title", "link", "text"],
          "properties": {
            "key": { "type": "string" },
            "title": { "type": "string" },
            "link": { "enum": [null, "exam", "navigation", "funk-oral", "funk-praxis"] },
            "text": { "type": "string" }
          }
        }
      },
      "faq": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": { "question": { "type": "string" }, "answer": { "type": "string" } } }
      },
      "providers": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": false, "required": ["name", "full", "url", "text"], "properties": { "name": { "type": "string" }, "full": { "type": "string" }, "url": { "type": "string" }, "text": { "type": "string" } } }
      },
      "courses": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["course_code", "first_variant", "tab_order"],
          "properties": {
            "course_code": { "$ref": "common.schema.json#/$defs/courseCode" },
            "first_variant": { "type": "string" },
            "tab_order": { "type": "integer" }
          }
        }
      },
      "sort_order": { "type": "integer" },
      "rights_status": { "$ref": "common.schema.json#/$defs/rightsStatus" },
      "source_file": { "$ref": "common.schema.json#/$defs/sourceFile" },
      "hash": { "$ref": "common.schema.json#/$defs/hash" }
    }
  }
}
