{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.learnboating.invalid/v1/praxis_forms.schema.json",
  "title": "Formulare der Praxis-Anmeldung (data/praxis_forms.json, ab 1.3)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "title", "min_progress_percent", "requires_fitness_certificate", "fields", "course_codes", "active", "sort_order", "rights_status", "source_file", "hash"],
    "properties": {
      "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "title": { "type": "string", "minLength": 1 },
      "min_progress_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
      "requires_fitness_certificate": { "type": "boolean" },
      "fields": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "label", "type", "required", "options", "help_text"],
          "properties": {
            "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "label": { "type": "string", "minLength": 1 },
            "type": { "enum": ["text", "textarea", "date", "checkbox", "select", "radio", "location"] },
            "required": { "type": "boolean" },
            "options": { "type": "array", "items": { "type": "string" } },
            "help_text": { "$ref": "common.schema.json#/$defs/nullableText" }
          }
        }
      },
      "course_codes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/courseCode" } },
      "active": { "type": "boolean" },
      "sort_order": { "type": "integer" },
      "rights_status": { "$ref": "common.schema.json#/$defs/rightsStatus" },
      "source_file": { "$ref": "common.schema.json#/$defs/sourceFile" },
      "hash": { "$ref": "common.schema.json#/$defs/hash" }
    }
  }
}
