{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.learnboating.invalid/v1/media.schema.json",
  "title": "Medien (data/media.json), Dateien unter media/",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "path", "media_type", "alt_text", "caption", "description", "source", "source_url", "rights_owner", "license_reference", "rights_status", "vector_source", "mime_type", "size", "sha256", "hash"],
    "properties": {
      "source_id": { "$ref": "common.schema.json#/$defs/sourceId" },
      "path": { "type": "string", "pattern": "^media/[^.][^\\\\]*$", "not": { "pattern": "\\.\\." } },
      "media_type": { "enum": ["image", "audio", "video", "document"] },
      "alt_text": { "$ref": "common.schema.json#/$defs/nullableText" },
      "caption": { "$ref": "common.schema.json#/$defs/nullableText" },
      "description": { "$ref": "common.schema.json#/$defs/nullableText" },
      "source": { "$ref": "common.schema.json#/$defs/nullableText" },
      "source_url": { "$ref": "common.schema.json#/$defs/nullableText" },
      "rights_owner": { "$ref": "common.schema.json#/$defs/nullableText" },
      "license_reference": { "$ref": "common.schema.json#/$defs/nullableText" },
      "rights_status": { "$ref": "common.schema.json#/$defs/rightsStatus" },
      "vector_source": { "type": ["string", "null"] },
      "mime_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
      "size": { "type": "integer", "minimum": 1 },
      "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
      "hash": { "$ref": "common.schema.json#/$defs/hash" }
    }
  }
}
