# Kopieren nach .env und ausfüllen. .env niemals einchecken.

# Pflicht: eigene, lange Passwörter
DB_PASSWORD=
STAGING_ADMIN_PASSWORD=

# Adresse, unter der die Seite im Browser aufgerufen wird (ohne / am Ende)
STAGING_URL=http://localhost:8080
STAGING_PORT=8080
# 127.0.0.1 = nur lokal erreichbar; 0.0.0.0 = im Netz erreichbar (Server ohne HTTPS-Profil)
STAGING_BIND=127.0.0.1

STAGING_TITLE=Kurswasser Staging
STAGING_ADMIN_USER=admin
STAGING_ADMIN_EMAIL=admin@example.invalid

# Optional: Demo-Lernkonto „demo_lernende“ (ohne Kauf) mit diesem Passwort anlegen
STAGING_DEMO_PASSWORD=

# 1 = Inhalte mit ungeklärtem Rechtestatus und Prüfungsregelwerke für die Abnahme freigeben
STAGING_RELEASE_RIGHTS=1

# Optional: HTTPS über Caddy (docker compose --profile https up -d), dann
# STAGING_URL=https://staging.example.de setzen
STAGING_DOMAIN=

# 1 = Fehlerprotokoll (docker compose exec wordpress tail /tmp/wp-debug.log)
WP_DEBUG=

# Nur falls Docker Hub nicht erreichbar/gedrosselt ist, z. B. mirror.gcr.io/library
# IMAGE_REGISTRY=docker.io/library

# Test-Postfach (Mailpit) für alle E-Mails der Staging-Seite: http://localhost:8025
MAILPIT_PORT=8025
# MAILPIT_IMAGE=mirror.gcr.io/axllent/mailpit:v1.27
