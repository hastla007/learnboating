{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.learnboating.invalid/v1/navigation_tasks.schema.json",
  "title": "Navigationsaufgaben mit Teilaufgaben (data/navigation_tasks.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "task_number", "course_codes", "scenario_text", "hint", "sort_order", "source", "source_version", "rights_status", "status", "source_file", "questions", "hash"],
    "properties": {
      "source_id": { "type": "string", "pattern": "^NAV-[0-9]{2,}$" },
      "task_number": { "type": "integer", "minimum": 1 },
      "course_codes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/courseCode" } },
      "scenario_text": { "type": "string", "minLength": 1 },
      "hint": { "$ref": "common.schema.json#/$defs/nullableText" },
      "sort_order": { "type": "integer" },
      "source": { "$ref": "common.schema.json#/$defs/nullableText" },
      "source_version": { "$ref": "common.schema.json#/$defs/nullableText" },
      "rights_status": { "$ref": "common.schema.json#/$defs/rightsStatus" },
      "status": { "$ref": "common.schema.json#/$defs/editorialStatus" },
      "source_file": { "$ref": "common.schema.json#/$defs/sourceFile" },
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "question_number", "question_text", "answer_text", "sort_order"],
          "properties": {
            "source_id": { "type": "string", "pattern": "^NAV-[0-9]{2,}-[0-9]{2,}$" },
            "question_number": { "type": "integer", "minimum": 1 },
            "question_text": { "type": "string", "minLength": 1 },
            "answer_text": { "type": "string", "minLength": 1 },
            "answer_values": {
              "description": "Ab 1.4 (optional): prüfbare Werte des amtlichen Ergebnisses aus der Pflegedatei tools/content-build/data/navigation_answer_values.json; Hilfe für die automatische Prüfung, die Selbsteinschätzung bleibt maßgeblich.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/answerValue" }
            },
            "sort_order": { "type": "integer" }
          }
        }
      },
      "hash": { "$ref": "common.schema.json#/$defs/hash" }
    }
  },
  "$defs": {
    "angle": { "type": "number", "minimum": 0, "maximum": 359.9 },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deg", "min", "hemisphere"],
      "properties": {
        "deg": { "type": "integer", "minimum": 0, "maximum": 180 },
        "min": { "type": "number", "minimum": 0, "maximum": 59.99 },
        "hemisphere": { "enum": ["N", "S", "E", "W"] }
      }
    },
    "answerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "quantity", "value", "unit", "tolerance"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantity": { "enum": ["course", "bearing", "angle", "distance", "time", "speed", "duration", "position"] },
        "value": {},
        "unit": { "enum": ["°", "sm", "Uhr", "kn", "min", "'"] },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "properties": { "quantity": { "enum": ["course", "bearing", "angle"] } } }, "then": { "properties": { "unit": { "const": "°" }, "value": { "$ref": "#/$defs/angle" } } } },
        { "if": { "properties": { "quantity": { "const": "distance" } } }, "then": { "properties": { "unit": { "const": "sm" }, "value": { "type": "number", "exclusiveMinimum": 0 } } } },
        { "if": { "properties": { "quantity": { "const": "speed" } } }, "then": { "properties": { "unit": { "const": "kn" }, "value": { "type": "number", "exclusiveMinimum": 0 } } } },
        { "if": { "properties": { "quantity": { "const": "duration" } } }, "then": { "properties": { "unit": { "const": "min" }, "value": { "type": "number", "exclusiveMinimum": 0 } } } },
        { "if": { "properties": { "quantity": { "const": "time" } } }, "then": { "properties": { "unit": { "const": "Uhr" }, "value": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } } },
        { "if": { "properties": { "quantity": { "const": "position" } } }, "then": { "properties": { "unit": { "const": "'" }, "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": { "lat": { "$ref": "#/$defs/coordinate" }, "lon": { "$ref": "#/$defs/coordinate" } }
        } } } }
      ]
    }
  }
}
