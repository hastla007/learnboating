{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.learnboating.invalid/v1/exam_papers.schema.json",
  "title": "Feste Prüfungs-/Übungsbögen (data/exam_papers.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "course_code", "paper_number", "sort_order", "copied_from", "source_file", "questions", "hash"],
    "properties": {
      "source_id": { "type": "string", "pattern": "^[A-Z0-9-]+#[0-9]{2,}$" },
      "course_code": { "$ref": "common.schema.json#/$defs/courseCode" },
      "paper_number": { "type": "integer", "minimum": 1 },
      "sort_order": { "type": "integer" },
      "copied_from": { "type": ["string", "null"] },
      "source_file": { "$ref": "common.schema.json#/$defs/sourceFile" },
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "question_source_id"],
          "properties": {
            "position": { "type": "integer", "minimum": 1 },
            "question_source_id": { "$ref": "common.schema.json#/$defs/sourceId" }
          }
        }
      },
      "hash": { "$ref": "common.schema.json#/$defs/hash" }
    }
  }
}
