{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.learnboating.invalid/v1/modules.schema.json",
  "title": "Module mit Fragenzuordnung (data/modules.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_id", "code", "name", "status", "sort_order", "questions", "source_file", "hash"],
    "properties": {
      "source_id": { "$ref": "common.schema.json#/$defs/moduleCode" },
      "code": { "$ref": "common.schema.json#/$defs/moduleCode" },
      "name": { "type": "string", "minLength": 1 },
      "status": { "$ref": "common.schema.json#/$defs/editorialStatus" },
      "sort_order": { "type": "integer" },
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question_source_id", "sort_order", "required"],
          "properties": {
            "question_source_id": { "$ref": "common.schema.json#/$defs/sourceId" },
            "sort_order": { "type": ["integer", "null"] },
            "required": { "type": "boolean" }
          }
        }
      },
      "source_file": { "$ref": "common.schema.json#/$defs/sourceFile" },
      "hash": { "$ref": "common.schema.json#/$defs/hash" }
    }
  }
}
