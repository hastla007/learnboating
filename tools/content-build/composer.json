{
    "name": "hastla007/learnboating-content-build",
    "description": "Konvertiert den Content-Snapshot von hastla007/boatingschool in ein Content-Paket für das WordPress-Lernplugin.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "opis/json-schema": "^2.3"
    },
    "autoload": {
        "psr-4": { "ContentBuild\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ContentBuild\\Tests\\": "tests/" }
    },
    "scripts": {
        "build": "php bin/build-package.php",
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}
