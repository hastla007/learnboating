{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        {
          "slug": "navy",
          "name": "Marineblau",
          "color": "#071B2E"
        },
        {
          "slug": "navy-soft",
          "name": "Tiefwasser",
          "color": "#102B45"
        },
        {
          "slug": "primary",
          "name": "Wasserblau (Aktion)",
          "color": "#29B6E6"
        },
        {
          "slug": "primary-dark",
          "name": "Wasserblau dunkel (Links)",
          "color": "#0A6F91"
        },
        {
          "slug": "yellow",
          "name": "Signalgelb",
          "color": "#F5B900"
        },
        {
          "slug": "mint",
          "name": "Mint (Binnen)",
          "color": "#65D7A5"
        },
        {
          "slug": "coral",
          "name": "Koralle (Funk)",
          "color": "#F47C5C"
        },
        {
          "slug": "ink",
          "name": "Text",
          "color": "#172B3D"
        },
        {
          "slug": "muted",
          "name": "Text gedämpft",
          "color": "#53657A"
        },
        {
          "slug": "line",
          "name": "Linien",
          "color": "#D7E0E8"
        },
        {
          "slug": "mist",
          "name": "Nebelhell",
          "color": "#F3F7FA"
        },
        {
          "slug": "white",
          "name": "Weiß",
          "color": "#FFFFFF"
        },
        {
          "slug": "success",
          "name": "Richtig",
          "color": "#168A5B"
        },
        {
          "slug": "error",
          "name": "Falsch",
          "color": "#C2413B"
        }
      ],
      "gradients": [
        {
          "slug": "deep-water",
          "name": "Tiefwasser",
          "gradient": "linear-gradient(160deg, #102B45 0%, #071B2E 70%)"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "Manrope (lokal)",
          "fontFamily": "Manrope, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/manrope-latin-wght-normal.woff2"
              ]
            },
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2"
              ]
            }
          ]
        },
        {
          "slug": "system",
          "name": "Systemschrift",
          "fontFamily": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Klein",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Normal",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          }
        },
        {
          "slug": "large",
          "name": "Groß",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.3rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Sehr groß",
          "size": "2.25rem",
          "fluid": {
            "min": "1.7rem",
            "max": "2.6rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "3.75rem",
          "fluid": {
            "min": "2.4rem",
            "max": "4.25rem"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "S",
          "size": "0.75rem"
        },
        {
          "slug": "30",
          "name": "M",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "L",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "XL",
          "size": "clamp(1.75rem, 3vw, 2.25rem)"
        },
        {
          "slug": "60",
          "name": "2XL",
          "size": "clamp(2.25rem, 5vw, 3.5rem)"
        },
        {
          "slug": "70",
          "name": "3XL",
          "size": "clamp(3rem, 8vw, 6rem)"
        }
      ],
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card",
          "name": "Karte",
          "shadow": "0 1px 2px rgba(7,27,46,.06), 0 10px 30px rgba(7,27,46,.08)"
        },
        {
          "slug": "lift",
          "name": "Angehoben",
          "shadow": "0 18px 50px rgba(7,27,46,.18)"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "left": "clamp(1rem, 4vw, 2rem)",
        "right": "clamp(1rem, 4vw, 2rem)"
      }
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--navy)"
        },
        "typography": {
          "fontWeight": "800",
          "lineHeight": "1.12",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "letterSpacing": "-0.01em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary-dark)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--navy)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--navy)"
        },
        "typography": {
          "fontWeight": "750",
          "fontSize": "1rem"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "#19A5D4"
          }
        },
        ":focus": {
          "outline": {
            "color": "var(--wp--preset--color--navy)",
            "offset": "3px",
            "style": "solid",
            "width": "2px"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.35rem",
          "fontWeight": "800",
          "letterSpacing": "-0.03em"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "inherit"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.97rem",
          "fontWeight": "650"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--line)",
          "text": "var(--wp--preset--color--line)"
        }
      },
      "core/details": {
        "border": {
          "bottom": {
            "color": "var(--wp--preset--color--line)",
            "width": "1px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "1rem"
          }
        }
      },
      "core/post-title": {
        "typography": {
          "lineHeight": "1.12"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--primary)",
            "width": "4px",
            "style": "solid"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Kopfbereich",
      "area": "header"
    },
    {
      "name": "header-checkout",
      "title": "Kopfbereich Kasse (reduziert)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Fußbereich",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "course",
      "title": "Kursseite (Info & Verkauf)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "landing",
      "title": "Landingpage (volle Breite)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-legal",
      "title": "Rechtstext (schmal)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-info",
      "title": "Infoseite (Kopf „Seekarte“)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
